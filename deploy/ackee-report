#!/usr/bin/env python3
"""Sends the state of the stands to the team chat (/etc/cron.d/ackee-report, ACKEE-125).

  ackee-report errors     every 10 minutes, writes only when something went wrong
  ackee-report daily      every morning: versions, traffic, errors, backup, disk
  ackee-report security   three times a week: dependencies, TLS, SSH, ports, updates

The bot token and the chat are the ones of Alertmanager (docs/engineering/alerts.md).
ACKEE_REPORT_DRY_RUN=1 prints the message instead of sending it.
"""

import datetime
import json
import os
import re
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

ROOT = os.environ.get('ACKEE_REPORT_ROOT', '/opt/ackee')
STATE = os.environ.get('ACKEE_REPORT_STATE', '/var/lib/ackee-report/state.json')
DRY_RUN = os.environ.get('ACKEE_REPORT_DRY_RUN') == '1'
RAW_URL = os.environ.get('ACKEE_REPORT_RAW_URL', 'https://raw.githubusercontent.com/Voronov/Ackee')
HOSTS = os.environ.get(
    'ACKEE_REPORT_HOSTS',
    'ackee2.varlex.app dev.ackee2.varlex.app ackee.varlex.app grafana.ackee.varlex.app prometeus.ackee.varlex.app',
).split()

STANDS = [('live', 'ackee-live', 'ackee_live'), ('dev', 'ackee-dev', 'ackee_dev')]

# Fatal lines we cannot fix: someone outside asks for the schema, and Apollo refuses
IGNORED = [re.compile(r'introspection is not allowed')]
UUID = re.compile(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
# Telegram refuses longer messages
LIMIT = 4000


def run(*args, timeout=120):
    try:
        done = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout + done.stderr if done.returncode == 0 else None


def prom(query):
    url = 'http://localhost:9090/api/v1/query?' + urllib.parse.urlencode({'query': query})
    out = run('docker', 'exec', 'ackee-prometheus', 'wget', '-qO-', url)
    try:
        return json.loads(out)['data']['result']
    except (TypeError, ValueError, KeyError):
        return None


def value(results, job=None):
    for result in results or []:
        if job is None or result['metric'].get('job') == job:
            return float(result['value'][1])
    return None


def fatal_lines(container, since):
    out = run('docker', 'logs', '--since', since, container)
    if out is None:
        return None
    lines = [line.strip() for line in out.splitlines() if '✖' in line]
    return [line for line in lines if not any(pattern.search(line) for pattern in IGNORED)]


def inspect(container, template):
    out = run('docker', 'inspect', '-f', template, container)
    return out.strip() if out is not None else None


def distinct(lines, count=3):
    seen = []
    for line in lines:
        short = UUID.sub('<id>', line)[:200]
        if short not in seen:
            seen.append(short)
    return seen[:count]


def chat_id():
    if os.environ.get('ACKEE_REPORT_CHAT_ID'):
        return os.environ['ACKEE_REPORT_CHAT_ID']
    with open(os.path.join(ROOT, '.env')) as env:
        for line in env:
            if line.startswith('ALERTMANAGER_TELEGRAM_CHAT_ID='):
                return line.split('=', 1)[1].strip()
    raise SystemExit('ALERTMANAGER_TELEGRAM_CHAT_ID is not set in .env')


def send(text):
    text = text if len(text) <= LIMIT else text[: LIMIT - 20] + '\n… (cut)'
    if DRY_RUN:
        print(text)
        return
    with open(os.path.join(ROOT, 'alertmanager/secrets/telegram_bot_token')) as file:
        token = file.read().strip()
    data = urllib.parse.urlencode({'chat_id': chat_id(), 'text': text, 'disable_web_page_preview': 'true'})
    urllib.request.urlopen(f'https://api.telegram.org/bot{token}/sendMessage', data.encode(), timeout=30)


def load_state():
    try:
        with open(STATE) as file:
            return json.load(file)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, 'w') as file:
        json.dump(state, file)


def number(amount):
    return f'{amount:,.0f}'.replace(',', ' ')


def errors():
    problems = []
    state = load_state()

    for stage, container, _ in STANDS:
        lines = fatal_lines(container, '10m')
        if lines:
            problems.append(f'{stage}: {len(lines)} fatal in the log\n' + '\n'.join(f'  {line}' for line in distinct(lines)))

        restarts = inspect(container, '{{.RestartCount}}')
        if restarts is not None and restarts.isdigit():
            before = state.get(container, {}).get('restarts')
            if before is not None and int(restarts) > before:
                problems.append(f'{stage}: the container restarted, {restarts} restarts')
            state[container] = {'restarts': int(restarts)}

    query = 'sum by (job, route, status) (increase(ackee_http_request_duration_seconds_count{status=~"5..",route!="/metrics"}[10m]))'
    for result in prom(query) or []:
        count = round(float(result['value'][1]))
        if count >= 1:
            metric = result['metric']
            stage = metric.get('job', '?').replace('ackee-', '')
            problems.append(f'{stage}: {count}× HTTP {metric.get("status")} on {metric.get("route")}')

    save_state(state)
    if problems:
        send('⚠️ Ackee: errors in the last 10 minutes\n\n' + '\n\n'.join(problems))
    return 0


TEST_DOMAIN = os.environ.get('ACKEE_REPORT_TEST_DOMAIN', 'northwind-coffee.example')
BACKUP_DIR = os.environ.get('ACKEE_REPORT_BACKUP_DIR', '/opt/ackee/backups')


def since_text(seconds):
    if seconds is None:
        return '?'
    days, hours = int(seconds // 86400), int(seconds % 86400 // 3600)
    minutes = int(seconds % 3600 // 60)
    return f'{days} d {hours} h' if days else f'{hours} h {minutes} min' if hours else f'{minutes} min'


def started_ago(started):
    # Docker gives nanoseconds, which fromisoformat does not take
    try:
        moment = datetime.datetime.strptime(started[:19], '%Y-%m-%dT%H:%M:%S').replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None
    return (datetime.datetime.now(datetime.timezone.utc) - moment).total_seconds()


def stand_data(database, since):
    """New records by domain and the state of the GA4 sync, in one call to mongosh."""
    script = (
        f'const since = ISODate("{since}"); const titles = {{}};'
        'db.domains.find({}, {id: 1, title: 1}).forEach((d) => { titles[d.id] = d.title });'
        'const records = {}; db.records.aggregate([{$match: {created: {$gte: since}}}, {$group: {_id: "$domainId", n: {$sum: 1}}}])'
        '.forEach((r) => { records[titles[r._id] || r._id] = r.n });'
        'const ga4 = db.ga4connections.find({}, {domainId: 1, lastSync: 1, lastError: 1}).toArray().map((c) => {'
        ' const day = db.ga4dailies.find({domainId: c.domainId}).sort({date: -1}).limit(1).toArray()[0];'
        ' return {title: titles[c.domainId] || c.domainId, lastSync: c.lastSync, error: c.lastError || null, lastDay: day ? day.date : null} });'
        'print(JSON.stringify({records, ga4}))'
    )
    out = run('docker', 'exec', 'ackee-mongo', 'mongosh', '--quiet', database, '--eval', script)
    try:
        return json.loads(out)
    except (TypeError, ValueError):
        return None


def megabytes(amount):
    return f'{amount / 2**20:.0f} MB' if amount is not None else '?'


def server_lines():
    lines = []
    try:
        with open('/proc/uptime') as file:
            uptime = float(file.read().split()[0])
    except (OSError, ValueError):
        uptime = None
    cpu_now = value(prom('100 * (1 - avg(rate(node_cpu_seconds_total{mode="idle"}[5m])))'))
    cpu_avg = value(prom('avg_over_time((100 * (1 - avg(rate(node_cpu_seconds_total{mode="idle"}[5m]))))[24h:5m])'))
    cpu_max = value(prom('max_over_time((100 * (1 - avg(rate(node_cpu_seconds_total{mode="idle"}[5m]))))[24h:5m])'))
    ram_min = value(prom('min_over_time(node_memory_MemAvailable_bytes[24h])'))
    ram_total = value(prom('node_memory_MemTotal_bytes'))
    percent = lambda amount: f'{amount:.0f} %' if amount is not None else '?'
    lines.append(f'  uptime {since_text(uptime)}, load {" / ".join(f"{load:.2f}" for load in os.getloadavg())}')
    lines.append(f'  CPU now {percent(cpu_now)}, over the day {percent(cpu_avg)} on average, {percent(cpu_max)} at most')
    if ram_min is not None and ram_total is not None:
        lines.append(f'  RAM: at least {ram_min / 2**30:.1f} of {ram_total / 2**30:.1f} GB free over the day, {memory()}')
    else:
        lines.append(f'  RAM: {memory()}')
    disk = shutil.disk_usage('/')
    lines.append(f'  disk {round(disk.used * 100 / (disk.used + disk.free))} % used, {disk.free / 2**30:.1f} GB free')
    return lines


def nightly():
    line = last_backup()
    match = re.match(r'(\d{4})-(\d\d)-(\d\d)T(\d\d:\d\d)\S*\s+(\w+)', line)
    return f'{match.group(5)}, {match.group(3)}.{match.group(2)} {match.group(4)} UTC' if match else line


def home_pull():
    """When the home server last took the dumps: a login of its read-only key, seen by sshd.
    The check of the dumps runs over there, so a login means the copy ran, not that it passed."""
    try:
        with open(os.environ.get('ACKEE_REPORT_AUTHORIZED_KEYS', '/root/.ssh/authorized_keys')) as file:
            line = next((line for line in file if 'pull ackee backups' in line), None)
    except OSError:
        line = None
    if line is None:
        return 'home server: no pull key'
    key = line[line.index('ssh-'):] if 'ssh-' in line else line
    try:
        done = subprocess.run(['ssh-keygen', '-lf', '/dev/stdin'], input=key, capture_output=True, text=True, timeout=10)
        fingerprint = done.stdout.split()[1]
    except (OSError, IndexError, subprocess.TimeoutExpired):
        return 'home server: the pull key could not be read'
    journal = run('journalctl', '-u', 'ssh', '--since', '48 hours ago', '--no-pager', '-q', '-o', 'short-iso') or ''
    logins = [entry for entry in journal.splitlines() if 'Accepted publickey' in entry and fingerprint in entry]
    if not logins:
        return '⚠️ home server: no pull in 48 h'
    when = datetime.datetime.fromisoformat(logins[-1].split()[0])
    hours = (datetime.datetime.now(datetime.timezone.utc) - when).total_seconds() / 3600
    mark = '⚠️ ' if hours > 26 else ''
    return f'{mark}home server: pulled {when.astimezone(datetime.timezone.utc):%d.%m %H:%M} UTC, {hours:.0f} h ago'


def backup_lines():
    try:
        dumps = [os.path.join(BACKUP_DIR, name) for name in os.listdir(BACKUP_DIR) if name.endswith('.archive.gz')]
    except OSError:
        return ['  the backup folder could not be read', f'  log: {last_backup()}']
    if not dumps:
        return ['  no dumps', f'  log: {last_backup()}']
    dumps.sort(key=os.path.getmtime)
    newest, oldest = dumps[-1], dumps[0]
    stamp = lambda path: datetime.datetime.fromtimestamp(os.path.getmtime(path), datetime.timezone.utc).strftime('%d.%m %H:%M')
    size = sum(os.path.getsize(path) for path in dumps)
    return [
        f'  newest {stamp(newest)} UTC, {os.path.getsize(newest) / 2**20:.0f} MB; nightly run: {nightly()}',
        f'  {len(dumps)} dumps in the folder, {size / 2**20:.0f} MB, the oldest from {stamp(oldest)}',
        f'  {home_pull()}',
    ]


def bans_since(hours):
    """Bans of fail2ban in its own log, which the journal does not have."""
    since = datetime.datetime.now() - datetime.timedelta(hours=hours)
    try:
        with open(os.environ.get('ACKEE_REPORT_FAIL2BAN_LOG', '/var/log/fail2ban.log'), errors='replace') as file:
            return sum(1 for line in file if ' Ban ' in line and line[:19] >= since.strftime('%Y-%m-%d %H:%M:%S'))
    except OSError:
        return None


def security_lines():
    banned = run('fail2ban-client', 'status', 'sshd') or ''
    now = re.search(r'Currently banned:\s*(\d+)', banned)
    journal = run('journalctl', '-u', 'ssh', '--since', '24 hours ago', '--no-pager', '-q')
    failed = len(re.findall(r'Invalid user|Failed password|Connection closed by invalid user', journal)) if journal is not None else None
    bans = bans_since(24)
    return [
        f'  fail2ban: {now.group(1) if now else "?"} banned now, {bans if bans is not None else "?"} new bans in the day',
        f'  failed SSH logins in the day: {failed if failed is not None else "?"}',
    ]


def daily():
    now = datetime.datetime.now(datetime.timezone.utc)
    since = (now - datetime.timedelta(days=1)).strftime('%Y-%m-%dT%H:%M:%SZ')
    parts = [f'☀️ Ackee: daily report, {now:%d.%m.%Y}']
    ga4 = []

    for stage, container, database in STANDS:
        job = f'ackee-{stage}'
        image = inspect(container, '{{.Config.Image}}') or '?'
        health = inspect(container, '{{.State.Health.Status}}') or 'not running'
        restarts = inspect(container, '{{.RestartCount}}') or '?'
        limit = inspect(container, '{{.HostConfig.Memory}}')

        requests = value(prom(f'sum(increase(ackee_http_request_duration_seconds_count{{job="{job}",route!="/metrics"}}[24h]))'))
        errors_5xx = value(prom(f'sum(increase(ackee_http_request_duration_seconds_count{{job="{job}",status=~"5..",route!="/metrics"}}[24h]))'))
        errors_4xx = value(prom(f'sum(increase(ackee_http_request_duration_seconds_count{{job="{job}",status=~"4..",route!="/metrics"}}[24h]))'))
        p95 = value(prom(f'histogram_quantile(0.95, sum by (le) (rate(ackee_http_request_duration_seconds_bucket{{job="{job}",route!="/metrics"}}[24h])))'))
        memory_max = value(prom(f'max_over_time(container_memory_usage_bytes{{name="{container}"}}[24h])'))
        fatal = fatal_lines(container, '24h')
        data = stand_data(database, since)

        if data is not None:
            test = data['records'].get(TEST_DOMAIN, 0)
            real = sum(count for title, count in data['records'].items() if title != TEST_DOMAIN)
            records = f'sites {number(real)}, test domain {number(test)}'
            if stage == 'live':
                ga4 = data['ga4']
        else:
            records = '?'

        memory_text = megabytes(memory_max) + (f' of {megabytes(int(limit))}' if limit and limit.isdigit() and int(limit) > 0 else '')
        parts.append('\n'.join([
            f'\n{stage}: {image.split(":")[-1]}, {health}, {restarts} restarts, up {since_text(started_ago(inspect(container, "{{.State.StartedAt}}") or ""))}',
            f'  requests {number(requests) if requests is not None else "?"}, p95 {f"{p95 * 1000:.0f} ms" if p95 is not None and p95 == p95 else "?"}, memory up to {memory_text}',
            f'  errors: 5xx {number(errors_5xx or 0) if requests is not None else "?"}, 4xx {number(errors_4xx or 0) if requests is not None else "?"}, '
            f'fatal in the log {len(fatal) if fatal is not None else "?"}',
            f'  new records: {records}',
        ]))

    parts.append('\nServer\n' + '\n'.join(server_lines()))
    parts.append('Backups of live\n' + '\n'.join(backup_lines()))
    parts.append('Security\n' + '\n'.join(security_lines()))

    if ga4:
        lines = []
        for connection in ga4:
            state = 'error' if connection['error'] else 'OK'
            synced = (connection['lastSync'] or '?')[:16].replace('T', ' ')
            lines.append(f'  {connection["title"]}: {state}, synced {synced} UTC, data up to {connection["lastDay"] or "?"}')
        parts.append('GA4\n' + '\n'.join(lines))

    fired = prom('max_over_time(ALERTS{alertstate="firing"}[24h])')
    names = sorted({result['metric'].get('alertname', '?') for result in fired or []})
    alerts = run('docker', 'exec', 'ackee-alertmanager', 'wget', '-qO-', 'http://localhost:9093/api/v2/alerts')
    try:
        active = sorted({alert['labels']['alertname'] for alert in json.loads(alerts) if alert['status']['state'] == 'active'})
        active_text = ', '.join(active) if active else 'none'
    except (TypeError, ValueError, KeyError):
        active_text = 'could not be checked'
    parts.append(f'Alerts: active {active_text}; fired in the day {", ".join(names) if names else "none"}')

    send('\n'.join(parts))
    return 0


def memory():
    try:
        with open('/proc/meminfo') as file:
            info = dict(line.split(':', 1) for line in file)
        return f'{int(info["MemAvailable"].split()[0]) / 2**20:.1f} of {int(info["MemTotal"].split()[0]) / 2**20:.1f} GB free now'
    except (OSError, KeyError, ValueError):
        return 'memory could not be checked'


def last_backup():
    try:
        with open(os.environ.get('ACKEE_REPORT_BACKUP_LOG', '/var/log/ackee-backup.log')) as file:
            lines = file.read().splitlines()
        return lines[-1] if lines else 'the log is empty'
    except OSError:
        return 'no log'


def audit(ref):
    folder = tempfile.mkdtemp(prefix='ackee-audit-')
    try:
        for name in ('package.json', 'package-lock.json'):
            with urllib.request.urlopen(f'{RAW_URL}/{ref}/{name}', timeout=60) as response:
                with open(os.path.join(folder, name), 'wb') as file:
                    file.write(response.read())
        # npm audit exits 1 when it finds something, so the exit code is not checked here
        done = subprocess.run(
            ['docker', 'run', '--rm', '-v', f'{folder}:/w', '-w', '/w', 'node:24-alpine', 'npm', 'audit', '--omit=dev', '--package-lock-only', '--json'],
            capture_output=True, text=True, timeout=300,
        )
        counts = json.loads(done.stdout)['metadata']['vulnerabilities']
        found = {level: counts.get(level, 0) for level in ('critical', 'high', 'moderate') if counts.get(level, 0)}
        return ', '.join(f'{level} {count}' for level, count in found.items()) or 'clean'
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return 'could not be checked'
    finally:
        shutil.rmtree(folder, ignore_errors=True)


def certificate_days(host):
    try:
        context = ssl.create_default_context()
        with socket.create_connection((host, 443), timeout=10) as raw, context.wrap_socket(raw, server_hostname=host) as tls:
            ends = datetime.datetime.strptime(tls.getpeercert()['notAfter'], '%b %d %H:%M:%S %Y %Z')
        return (ends - datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)).days
    except (OSError, ValueError, KeyError):
        return None


def security():
    parts = [f'🛡 Ackee: security check, {datetime.datetime.now(datetime.timezone.utc):%d.%m.%Y}']

    refs = []
    for stage, container, _ in STANDS:
        tag = (inspect(container, '{{.Config.Image}}') or '').split(':')[-1]
        # dev runs sha-<commit>, which is develop or a little behind it
        refs.append((stage, 'develop' if tag.startswith('sha-') or not tag else tag))
    parts.append('\nDependencies (npm audit, without dev):')
    for stage, ref in refs:
        parts.append(f'  {stage} ({ref}): {audit(ref)}')

    parts.append('\nTLS certificates:')
    for host in HOSTS:
        days = certificate_days(host)
        mark = '' if days is None or days > 21 else ' ⚠️'
        parts.append(f'  {host}: {"could not be checked" if days is None else f"{days} days left"}{mark}')

    journal = run('journalctl', '-u', 'ssh', '--since', '3 days ago', '--no-pager', '-q')
    failed = len(re.findall(r'Invalid user|Failed password|Connection closed by invalid user', journal)) if journal is not None else None
    banned = run('fail2ban-client', 'status', 'sshd')
    match = re.search(r'Total banned:\s*(\d+)', banned or '')
    parts.append(
        f'\nSSH in 3 days: {failed if failed is not None else "?"} failed logins, '
        f'{match.group(1) if match else "?"} banned by fail2ban since its start'
    )

    listening = run('ss', '-tlnH')
    if listening is not None:
        ports = set()
        for line in listening.splitlines():
            fields = line.split()
            if len(fields) >= 4 and not fields[3].startswith(('127.', '[::1]')):
                ports.add(fields[3].rsplit(':', 1)[-1])
        parts.append('Open ports: ' + ', '.join(sorted(ports, key=lambda port: int(port) if port.isdigit() else 0)))
    else:
        parts.append('Open ports: could not be checked')

    upgradable = run('apt', 'list', '--upgradable')
    if upgradable is not None:
        security_updates = sum(1 for line in upgradable.splitlines() if '-security' in line)
        parts.append(f'OS security updates: {security_updates}' + (' (a reboot is pending)' if os.path.exists('/var/run/reboot-required') else ''))
    else:
        parts.append('OS security updates: could not be checked')

    send('\n'.join(parts))
    return 0


MODES = {'errors': errors, 'daily': daily, 'security': security}

if __name__ == '__main__':
    if len(sys.argv) != 2 or sys.argv[1] not in MODES:
        raise SystemExit('Usage: ackee-report errors|daily|security')
    sys.exit(MODES[sys.argv[1]]())
