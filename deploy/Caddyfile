# Caddy gets and renews the Let's Encrypt certificates itself.
# All five names point to 178.104.38.165.

ackee.varlex.app {
	encode gzip
	reverse_proxy ackee-v1:3000
}

ackee2.varlex.app {
	encode gzip
	reverse_proxy ackee-live:3000
}

dev.ackee2.varlex.app {
	encode gzip
	# A test stand: keep it out of search results.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy ackee-dev:3000
}

prometeus.ackee.varlex.app {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	# Prometheus has no login of its own. With empty values Caddy refuses to start, so set both in .env.
	basic_auth {
		{$PROMETHEUS_USER} {$PROMETHEUS_PASSWORD_HASH}
	}
	reverse_proxy prometheus:9090
}

grafana.ackee.varlex.app {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	# Grafana has its own login (GRAFANA_ADMIN_USER and GRAFANA_ADMIN_PASSWORD in .env)
	reverse_proxy grafana:3000
}
